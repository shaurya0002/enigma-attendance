# Set these in Netlify: Site configuration -> Environment variables (mark as secret).
# For local dev with `netlify dev`, copy to .env (never commit it).
JSONBIN_MASTER_KEY=
JSONBIN_BIN_ID=
# node scripts/tools.mjs secret
SESSION_SECRET=
# exactly 8 letters. node scripts/tools.mjs key
ADMIN_KEY=
# JSON: username -> password (plaintext or scrypt$... from `node scripts/tools.mjs hash <pw>`)
ADMIN_USERS={"admin":"change-me-long-password"}
